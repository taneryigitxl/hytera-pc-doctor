<Application x:Class="PCDoctor.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B101A"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#151C2B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3D8BFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F6FB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E9BB3"/>
    </Application.Resources>
</Application>
