<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCDoctor.Setup</RootNamespace>
    <AssemblyName>TondyPcDoctor-Setup</AssemblyName>
    <ApplicationIcon>..\PCDoctor.App\Assets\app.ico</ApplicationIcon>
    <ApplicationTitle>Tondy Pc Doctor Kurulum</ApplicationTitle>
    <Product>Tondy Pc Doctor</Product>
    <Company>Tondy</Company>
    <Version>1.3.0</Version>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\PCDoctor.exe" LogicalName="payload.exe" Condition="Exists('payload\PCDoctor.exe')" />
    <Resource Include="..\PCDoctor.App\Assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>
</Project>
