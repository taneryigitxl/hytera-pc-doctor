<Window x:Class="PCDoctor.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hytera Pc Doctor Kurulum"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B101A">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/logo.png"
                   Width="40"
                   Height="40"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hytera Pc Doctor" FontSize="20" FontWeight="SemiBold" Foreground="#3D8BFF"/>
                <TextBlock Text="Kurulum" Foreground="#8E9BB3" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1"
                   x:Name="StatusText"
                   Text="Kurulum, uygulamayı masaüstüne kopyalar. Sonra kısayol yerine doğrudan Hytera Pc Doctor.exe ile açabilirsiniz."
                   Foreground="#F3F6FB"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <DockPanel Grid.Row="2">
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Content="Kapat"
                    Width="110"
                    Height="36"
                    Margin="8,0,0,0"
                    Click="CloseButton_OnClick"/>
            <Button x:Name="InstallButton"
                    DockPanel.Dock="Right"
                    Content="Kur"
                    Width="110"
                    Height="36"
                    Click="InstallButton_OnClick"/>
            <ProgressBar x:Name="Progress"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
