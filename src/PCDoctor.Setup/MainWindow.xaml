<Window x:Class="PCDoctor.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tondy Pc Doctor Kurulum"
        Width="480"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0B101A"
        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="KurButton" TargetType="Button">
            <Setter Property="Background" Value="#3D8BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="21"
                                Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5A9DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#273247" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Tondy Pc Doctor Kurulum"
                           Foreground="#8E9BB3"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <Button HorizontalAlignment="Right"
                        Width="40"
                        Height="40"
                        Content="✕"
                        FontSize="12"
                        Foreground="#8E9BB3"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_OnClick"/>
            </Grid>

            <Grid Grid.Row="1" Margin="40,12,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="56"
                           Height="56"
                           HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Tondy Pc Doctor"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#F3F6FB"
                               Margin="0,22,0,0"/>
                    <TextBlock Text="Windows tanı kurulumu"
                               Foreground="#8E9BB3"
                               FontSize="14"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Kurulum, programı yükler ve masaüstüne Tondy Pc Doctor kısayolunu ekler. Sonra o simgeden çalıştır."
                               Foreground="#F3F6FB"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,28,0,0"/>
                    <ProgressBar x:Name="Progress"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,28,0,0"
                                 Foreground="#3D8BFF"
                                 Background="#E8EEF8"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Kuruluma hazır."
                               Foreground="#8E9BB3"
                               FontSize="13"
                               Margin="0,12,0,0"/>
                </StackPanel>

                <Button x:Name="InstallButton"
                        Grid.Row="2"
                        Content="Kur"
                        Width="120"
                        Height="42"
                        HorizontalAlignment="Left"
                        Style="{StaticResource KurButton}"
                        Click="InstallButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</Window>
