<UserControl x:Class="PCDoctor.App.Views.EventLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource EventLogs.Apply}" Style="{StaticResource GhostButton}" Command="{Binding ApplyFilterCommand}" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource EventLogs.Reload}" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource EventLogs.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource EventLogs.Subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,8"/>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource EventLogs.Tip.Source}"/>
                <TextBox Grid.Column="2" Text="{Binding MessageFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource EventLogs.Tip.Message}"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding Levels}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLevel}"/>
                <ComboBox Grid.Column="6" ItemsSource="{Binding Logs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedLog}"/>
                <TextBox Grid.Column="8" Text="{Binding EventIdText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource EventLogs.Tip.EventId}"/>
            </Grid>
            <TextBlock Text="{Binding VisibleCountLabel}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0">
            <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Time}" Binding="{Binding TimeCreated, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Log}" Binding="{Binding LogName}" Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Level}" Binding="{Binding Level}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Source}" Binding="{Binding Source}" Width="180"/>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Id}" Binding="{Binding EventId}" Width="70"/>
                    <DataGridTextColumn Header="{DynamicResource EventLogs.Col.Message}" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
