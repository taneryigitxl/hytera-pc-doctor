<UserControl x:Class="PCDoctor.App.Views.OverlaySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="{DynamicResource Settings.Overlay.Title}" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{DynamicResource Settings.Overlay.Hint}" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.Enabled}"
                      IsChecked="{Binding OverlayEnabled}"/>
            <TextBlock Text="{DynamicResource Settings.Overlay.Position}" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
            <UniformGrid Columns="2">
                <RadioButton Content="{DynamicResource Settings.Overlay.TopLeft}"
                             GroupName="OverlayCorner"
                             IsChecked="{Binding OverlayTopLeft}"
                             Margin="0,0,8,8"/>
                <RadioButton Content="{DynamicResource Settings.Overlay.TopRight}"
                             GroupName="OverlayCorner"
                             IsChecked="{Binding OverlayTopRight}"
                             Margin="0,0,0,8"/>
                <RadioButton Content="{DynamicResource Settings.Overlay.BottomLeft}"
                             GroupName="OverlayCorner"
                             IsChecked="{Binding OverlayBottomLeft}"
                             Margin="0,0,8,0"/>
                <RadioButton Content="{DynamicResource Settings.Overlay.BottomRight}"
                             GroupName="OverlayCorner"
                             IsChecked="{Binding OverlayBottomRight}"/>
            </UniformGrid>
            <TextBlock Text="{DynamicResource Settings.Overlay.Metrics}" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.CpuUsage}" IsChecked="{Binding OverlayCpuUsage}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.CpuTemp}" IsChecked="{Binding OverlayCpuTemp}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.GpuUsage}" IsChecked="{Binding OverlayGpuUsage}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.GpuTemp}" IsChecked="{Binding OverlayGpuTemp}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.Ram}" IsChecked="{Binding OverlayRam}" Margin="0,0,0,8"/>
            <CheckBox Content="{DynamicResource Settings.Overlay.Disk}" IsChecked="{Binding OverlayDisk}"/>
        </StackPanel>
    </Border>
</UserControl>
