<UserControl x:Class="PCDoctor.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCDoctor.App.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <TextBlock Text="{DynamicResource Reports.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Reports.Subtitle}" Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource BannerBorder}" Margin="0,16,0,12"
                    Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{DynamicResource Reports.Empty}"/>
            </Border>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibility}}">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding StartedLabel}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding CompletedLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Scan.Ok}" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding OkCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SeverityOkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Scan.Warning}" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding WarningCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SeverityWarningBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Scan.Critical}" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SeverityCriticalBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Reports.ExportTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ExportNote}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ExportFileName}" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ExportBlueprint.Notes}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:FindingView/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
