<UserControl x:Class="PCDoctor.App.Views.OverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PCDoctor.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <TextBlock Text="{DynamicResource Overlay.PageTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Overlay.PageSubtitle}" Style="{StaticResource PageSubtitle}"/>
            <views:OverlaySettingsPanel Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
