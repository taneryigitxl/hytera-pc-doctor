<UserControl x:Class="PCDoctor.App.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PCDoctor.App.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Refresh}" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Hardware.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Hardware.Subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BannerBorder}">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DetailCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
