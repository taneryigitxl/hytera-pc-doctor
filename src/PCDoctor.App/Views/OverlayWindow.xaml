<Window x:Class="PCDoctor.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tondy Overlay"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False"
        ShowActivated="False">
    <Border Background="#CC0B101A"
            BorderBrush="#3D8BFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10">
        <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="#8E9BB3"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Value}"
                                   Foreground="#3D8BFF"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
