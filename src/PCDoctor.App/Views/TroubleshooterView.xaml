<UserControl x:Class="PCDoctor.App.Views.TroubleshooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <TextBlock Text="{DynamicResource Troubleshooter.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Notice}" Style="{StaticResource PageSubtitle}"/>
            <ItemsControl ItemsSource="{Binding Scenarios}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                        <TextBlock Text="{DynamicResource Troubleshooter.Planned}" Style="{StaticResource MutedText}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding PlannedChecks}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
