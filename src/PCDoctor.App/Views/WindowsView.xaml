<UserControl x:Class="PCDoctor.App.Views.WindowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Common.Refresh}" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"/>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Windows.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{DynamicResource Windows.Subtitle}" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"/>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding Value}" Grid.Column="1"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <ItemsControl ItemsSource="{Binding PendingRebootReasons}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BannerBorder}">
                            <TextBlock Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
