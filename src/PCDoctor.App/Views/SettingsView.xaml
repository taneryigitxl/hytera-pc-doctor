<UserControl x:Class="PCDoctor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,0,16,16">
            <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource CardTitle}"/>
                    <CheckBox Content="{DynamicResource Settings.DarkTheme}"
                              IsChecked="{Binding IsDarkTheme}"
                              Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{DynamicResource Settings.LanguageHint}" Style="{StaticResource MutedText}" Margin="0,8,0,10"/>
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Name"
                              Width="220"
                              HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Session}" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Settings.Version}" Style="{StaticResource MutedText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                        <TextBlock Grid.Row="1" Text="{DynamicResource Settings.User}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserName}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="{DynamicResource Settings.Elevation}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Elevation}" Margin="0,8,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Logging}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{Binding LogDirectory}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding CurrentLogFile}" Margin="0,6,0,12"/>
                    <Button Content="{DynamicResource Settings.OpenLogs}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding OpenLogsCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource BannerBorder}">
                <TextBlock Text="{Binding SafetyNote}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
